{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/dsh-ui-restore/ui-spec.schema.json",
  "title": "dsh-ui-restore ui-spec",
  "description": "期望样式契约：ui_probe 按 elements[].properties 逐个对比 getComputedStyle。属性名使用驼峰写法；数字长度按 px 处理。",
  "type": "object",
  "additionalProperties": false,
  "required": ["elements"],
  "properties": {
    "version": {
      "const": 1,
      "description": "契约版本，目前只支持 1"
    },
    "name": {
      "type": "string",
      "description": "契约名称，写进报告"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "dpr": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "description": "数值容差；省略时 length=0.5、number=0.01、color=0",
      "properties": {
        "length": { "type": "number", "minimum": 0 },
        "number": { "type": "number", "minimum": 0 },
        "color": { "type": "number", "minimum": 0 }
      }
    },
    "notes": { "type": "string" },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "properties"],
        "properties": {
          "selector": { "type": "string", "minLength": 1, "description": "CSS 选择器，取第一个匹配元素" },
          "label": { "type": "string", "description": "人类可读名称" },
          "note": { "type": "string" },
          "properties": {
            "type": "object",
            "minProperties": 1,
            "description": "属性名必须是下方 propertyNames 枚举之一；值可以是数字（长度按 px、数值属性按数字）或字符串。色彩支持 #hex / rgb() / rgba() / hsl()；长度支持 12px / 1rem / auto 等；阴影与字体族按归一化字符串比较。",
            "propertyNames": {
              "enum": [
                "fontSize",
                "lineHeight",
                "letterSpacing",
                "wordSpacing",
                "textIndent",
                "width",
                "height",
                "minWidth",
                "minHeight",
                "maxWidth",
                "maxHeight",
                "paddingTop",
                "paddingRight",
                "paddingBottom",
                "paddingLeft",
                "marginTop",
                "marginRight",
                "marginBottom",
                "marginLeft",
                "gap",
                "rowGap",
                "columnGap",
                "borderWidth",
                "borderTopWidth",
                "borderRightWidth",
                "borderBottomWidth",
                "borderLeftWidth",
                "borderRadius",
                "borderTopLeftRadius",
                "borderTopRightRadius",
                "borderBottomRightRadius",
                "borderBottomLeftRadius",
                "outlineWidth",
                "outlineOffset",
                "top",
                "right",
                "bottom",
                "left",
                "flexBasis",
                "verticalAlign",
                "color",
                "backgroundColor",
                "borderColor",
                "borderTopColor",
                "borderRightColor",
                "borderBottomColor",
                "borderLeftColor",
                "outlineColor",
                "caretColor",
                "textDecorationColor",
                "fontWeight",
                "opacity",
                "zIndex",
                "flexGrow",
                "flexShrink",
                "order",
                "display",
                "position",
                "flexDirection",
                "flexWrap",
                "alignItems",
                "justifyContent",
                "alignContent",
                "alignSelf",
                "justifySelf",
                "textAlign",
                "textTransform",
                "textDecorationLine",
                "overflow",
                "overflowX",
                "overflowY",
                "whiteSpace",
                "boxSizing",
                "fontStyle",
                "visibility",
                "float",
                "clear",
                "cursor",
                "pointerEvents",
                "wordBreak",
                "overflowWrap",
                "objectFit",
                "userSelect",
                "textOverflow",
                "fontVariantNumeric",
                "boxShadow",
                "textShadow",
                "fontFamily"
              ]
            },
            "additionalProperties": {
              "oneOf": [
                { "type": "number" },
                { "type": "string" }
              ]
            }
          }
        }
      }
    }
  }
}
