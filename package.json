{
  "name": "dsh-ui-restore",
  "version": "0.4.0",
  "description": "UI restoration closed loop for DeepSeek Harness: screenshot capture, canvas-aligned pixel diff, computed-style probes, and a static acceptance report (Markdown + single-file HTML).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctfliar/dsh-ui-restore.git"
  },
  "homepage": "https://github.com/ctfliar/dsh-ui-restore#readme",
  "bugs": {
    "url": "https://github.com/ctfliar/dsh-ui-restore/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./schemas/ui-spec.schema.json": "./schemas/ui-spec.schema.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "schemas",
    "profiles",
    "skills",
    "docs/*.md",
    "docs/knowledge/*.md",
    "docs/knowledge/**/*.md",
    "docs/knowledge/patterns/*.json",
    "docs/knowledge/patterns/*.html",
    "examples",
    "scripts",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20.10.0",
    "dsh": ">=0.2.2-rc.5 || >=0.3.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "selftest:browser": "node scripts/selftest.mjs --browser",
    "release:dry": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs --bump patch --apply",
    "release:minor": "node scripts/release.mjs --bump minor --apply",
    "check": "node --check lib/index.js && node --check lib/browser.js && node --check lib/diff.js && node --check lib/image.js && node --check lib/style.js && node --check lib/probe.js && node --check lib/spec.js && node --check lib/profile.js && node --check lib/paths.js && node --check lib/report.js && node --check lib/skill.js && node --check scripts/selftest.mjs && node --check scripts/release.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "ui",
    "visual-regression",
    "playwright",
    "acceptance",
    "pixel-diff"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.49.0"
  }
}
